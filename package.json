{
  "name": "misub",
  "version": "0.0.1-alpha.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "npx wrangler pages dev public --port 8787",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:ci": "node scripts/test-gates/vitest.mjs tmp/test-gates/vitest-summary.json",
    "test:probes": "node scripts/test-gates/node.mjs",
    "test:browser": "node scripts/test-gates/browser.mjs",
    "test:gates": "node --test tests/gates/*.test.mjs",
    "format": "prettier --write \"functions/**/*.js\" \"src/**/*.{js,vue}\" \"tests/**/*.js\" \"docs/**/*.md\"",
    "format:check": "prettier --check \"functions/**/*.js\" \"src/**/*.{js,vue}\" \"tests/**/*.js\" \"docs/**/*.md\""
  },
  "dependencies": {
    "dompurify": "^3.2.6",
    "js-yaml": "^4.1.0",
    "pinia": "^3.0.3",
    "qrcode": "^1.5.4",
    "vue": "^3.5.18",
    "vue-router": "^4.6.4",
    "vuedraggable": "^4.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/test-utils": "^2.4.6",
    "happy-dom": "^20.0.11",
    "miniflare": "^4.20250803.0",
    "playwright": "^1.60.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.1.12",
    "terser": "^5.48.0",
    "vite": "^7.1.2",
    "vitest": "^4.0.16",
    "wrangler": "^4.56.0"
  }
}
