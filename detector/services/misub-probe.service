# Install as a user service after replacing both absolute paths.
[Unit]
Description=MiSub outbound node detector
After=network-online.target

[Service]
Type=simple
ExecStart=/ABSOLUTE/PATH/misub-probe-linux-amd64 --config /ABSOLUTE/PATH/probe.json
Restart=on-failure
RestartSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
