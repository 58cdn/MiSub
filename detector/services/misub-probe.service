# Manual-start user-service example. Replace both absolute paths.
[Unit]
Description=MiSub outbound node detector

[Service]
Type=exec
ExecStart=:"/ABSOLUTE/PATH/misub-probe-linux-amd64" --config "/ABSOLUTE/PATH/probe.json"
Restart=no
UMask=0077
NoNewPrivileges=true
KillMode=control-group
TimeoutStopSec=20
